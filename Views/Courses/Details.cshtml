@model Course
@{ ViewData["Title"] = "Course Details"; }
<h1>Course Details</h1><dl class="row"><dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd>
<dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd><dt class="col-sm-3">Fee</dt><dd class="col-sm-9">@Model.Fee.ToString("C")</dd>
<dt class="col-sm-3">Start date</dt><dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd")</dd>
<dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.CreatedAtUtc.ToString("u")</dd></dl>
<a asp-action="Index" class="btn btn-secondary">Back</a>
