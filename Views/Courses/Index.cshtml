@model IEnumerable<Course>
@{ ViewData["Title"] = "Courses"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Courses</h1>
@if (User.IsInRole("Admin")) { <a class="btn btn-primary" asp-action="Create">Add Course</a> }</div>
<table class="table table-striped"><thead><tr><th>Course</th><th>Department</th><th>Fee</th><th>Start date</th><th>Actions</th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td>@c.Title</td><td>@c.Department</td><td>@c.Fee.ToString("C")</td><td>@c.StartDate.ToString("yyyy-MM-dd")</td><td>
<a asp-action="Details" asp-route-id="@c.Id">Details</a>
@if (User.IsInRole("Admin")) {
 <span> | </span><a asp-action="Edit" asp-route-id="@c.Id">Edit</a><span> | </span><a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
 <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline"><input type="hidden" name="courseId" value="@c.Id" /><button class="btn btn-sm btn-outline-primary" type="submit">Add to cart</button></form>
}
</td></tr> }
</tbody></table>
