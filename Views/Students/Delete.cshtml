@model Student
@{ ViewData["Title"] = "Delete Student"; }
<h1>Delete Student</h1><div class="alert alert-warning">Are you sure you want to delete this student?</div>
<p><strong>@Model.FullName</strong> — @Model.Email</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button class="btn btn-danger" type="submit">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
