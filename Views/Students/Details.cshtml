@model Student
@{ ViewData["Title"] = "Student Details"; }
<h1>Student Details</h1>
<dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.FullName</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Department</dt><dd class="col-sm-9">@Model.Department</dd>
<dt class="col-sm-3">Enrollment date</dt><dd class="col-sm-9">@Model.EnrollmentDate.ToString("yyyy-MM-dd")</dd>
<dt class="col-sm-3">Created (UTC)</dt><dd class="col-sm-9">@Model.CreatedAtUtc.ToString("u")</dd></dl>
<a asp-action="Index" class="btn btn-secondary">Back</a>
